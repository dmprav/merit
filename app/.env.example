VITE_CLERK_PUBLISHABLE_KEY=
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://eu.i.posthog.com

# Server environment for local development.
APP_ORIGIN=http://localhost:3000
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_ISSUER=

# Server-only Clerk user IDs, separated by commas. Empty denies all operators.
MERIT_OPERATOR_USER_IDS=
MAILPIT_URL=http://127.0.0.1:8025
EMAIL_FROM=invitations@merit.local
RESEND_API_KEY=

# Private S3-compatible storage, matching the local Compose service.
FILE_STORAGE_ENDPOINT=http://127.0.0.1:8333
FILE_STORAGE_REGION=us-east-1
FILE_STORAGE_BUCKET=merit-files
FILE_STORAGE_ACCESS_KEY_ID=merit-local
FILE_STORAGE_SECRET_ACCESS_KEY=merit-local-storage

# Optional OTLP/HTTP trace export (off when endpoint is empty).
OTEL_SERVICE_NAME=merit
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_TRACE_FILTER=checkly
