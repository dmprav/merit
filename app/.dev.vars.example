RESEND_API_KEY=

# Optional OTLP/HTTP trace export (off when endpoint is empty).
OTEL_SERVICE_NAME=merit
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_TRACE_FILTER=checkly
